LLAMA_BASE_URL=http://127.0.0.1:8082/v1
LLAMA_API_KEY=sk-no-key-required
LLAMA_MODEL=local-model
A2A_HOST=127.0.0.1
A2A_PORT=9999

# The default is the MCP fetch example. You can replace it with another stdio server.
MCP_COMMAND=uvx
MCP_ARGS=mcp-server-fetch
MCP_TIMEOUT_SECONDS=60
LLAMA_MAX_TOOL_ROUNDS=4
MCP_CONFIG_PATH=.data/mcp_config.json
